{% if has_aircraft %}
  <div class="layout layout--col layout--center">
    <span class="value value--xxlarge lg:value--xxxlarge" data-value-fit="true">{{ aircraft.identifier }}</span>
    {% if aircraft.operator %}
      <span class="label lg:label--large lg:portrait:label--xxlarge" data-clamp="1">{{ aircraft.operator }}</span>
    {% endif %}
    <span class="title lg:title--xlarge lg:portrait:title--xxlarge" data-clamp="1">{{ aircraft.distance_display }} {{ aircraft.bearing_compass }}</span>
    <span class="description lg:description--large lg:portrait:description--xlarge" data-clamp="1">{{ aircraft.altitude_display }} · {{ aircraft.speed_display }}</span>
  </div>
  <div class="title_bar title_bar--small">
    <span class="title">Overhead</span>
    <span class="instance">{{ aircraft.source_label }}</span>
  </div>
{% else %}
  <div class="layout layout--col layout--center">
    {% if status == "no_aircraft" %}
      <span class="value value--large lg:value--xlarge" data-value-fit="true">Clear sky</span>
      <span class="description lg:description--large" data-clamp="2">No aircraft within {{ search_radius_nm }} nm</span>
    {% elsif status == "configuration_error" %}
      <span class="title lg:title--xlarge" data-clamp="2">Tracker not configured</span>
      <span class="description lg:description--large" data-clamp="3">{{ message }}</span>
    {% else %}
      <span class="title lg:title--xlarge" data-clamp="2">Aircraft data unavailable</span>
      <span class="description lg:description--large" data-clamp="3">{{ message }}</span>
    {% endif %}
  </div>
  <div class="title_bar title_bar--small">
    <span class="title">Overhead</span>
    <span class="instance">{{ location_label }}</span>
  </div>
{% endif %}
