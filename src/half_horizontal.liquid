{% if has_aircraft %}
  <div class="layout portrait:layout--col gap--space-between">
    <div class="item portrait:w--full">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--xxlarge" data-value-fit="true">{{ aircraft.identifier }}</span>
        {% if aircraft.operator %}
          <span class="title" data-clamp="1">{{ aircraft.operator }}</span>
          <span class="description" data-clamp="1">{{ aircraft.route }} · {{ aircraft.aircraft_label }}</span>
        {% else %}
          <span class="title" data-clamp="1">{{ aircraft.route }}</span>
          <span class="description" data-clamp="1">{{ aircraft.aircraft_label }}</span>
        {% endif %}
      </div>
    </div>
    <div class="grid grid--cols-2 portrait:w--full">
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--medium value--tnums" data-value-fit="true">{{ aircraft.distance_display }}</span>
          <span class="label" data-clamp="2">{{ aircraft.bearing_compass }} of {{ location_label }}</span>
        </div>
      </div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--medium value--tnums" data-value-fit="true">{{ aircraft.altitude_compact }}</span>
          <span class="label" data-clamp="2">{{ aircraft.speed_display }} · {{ aircraft.heading_compass }}</span>
        </div>
      </div>
    </div>
  </div>
  <div class="title_bar title_bar--small">
    <span class="title">Overhead Flight Tracker</span>
    <span class="instance">{{ aircraft.source_label }} · {{ aircraft.age_display }}</span>
  </div>
{% else %}
  <div class="layout layout--col layout--center">
    <span class="value value--large">No aircraft</span>
    <span class="description">{{ message }}</span>
  </div>
  <div class="title_bar title_bar--small">
    <span class="title">Overhead Flight Tracker</span>
    <span class="instance">{{ location_label }}</span>
  </div>
{% endif %}
