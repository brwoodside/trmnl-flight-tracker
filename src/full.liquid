{% comment %}
Only the radar geometry needs custom CSS. Text and layout use Framework
classes so device fonts, responsive sizes, and content fitting stay native.
{% endcomment %}
<style>
  .radar-scope-shell {
    position: relative;
    min-height: 0;
  }

  .radar-scope {
    position: absolute;
    width: 100%;
    height: 100%;
  }

  .radar-axis,
  .radar-ring--inner {
    fill: none;
    stroke: #000;
    stroke-width: .45;
    stroke-dasharray: 1.1 1.8;
  }

  .radar-ring--outer {
    fill: #fff;
    stroke: #000;
    stroke-width: .65;
  }

  .radar-tick,
  .radar-center-mark {
    fill: none;
    stroke: #000;
    stroke-width: .85;
    stroke-linecap: square;
  }

  .radar-north-disc {
    fill: #fff;
    stroke: #000;
    stroke-width: .55;
  }

  .radar-north-label {
    fill: #000;
    font-family: var(--label-font-family);
    font-size: 3.2px;
    text-anchor: middle;
    dominant-baseline: central;
  }

  .radar-target {
    fill: #000;
  }

  .radar-target-dot {
    fill: #000;
    stroke: #fff;
    stroke-width: .7;
  }
</style>

{% if has_aircraft or status == "no_aircraft" %}
  <div class="layout layout--row portrait:layout--col gap--small lg:gap--large">
    <div class="flex flex--col stretch gap--small">
      <span class="label lg:label--large w--full">Up {{ scope.map_up_compass }} · {{ scope.map_up_bearing_deg }}°T</span>
      <div class="radar-scope-shell stretch w--full">
        <svg class="radar-scope" viewBox="3.5 3.5 93 93" role="img" aria-labelledby="radar-title radar-description">
        <title id="radar-title">Aircraft range and bearing scope</title>
        {% if has_aircraft %}
          <desc id="radar-description">{{ aircraft.identifier }} is {{ aircraft.distance_display }} {{ aircraft.bearing_compass }} of {{ location_label }}.</desc>
        {% else %}
          <desc id="radar-description">No fresh aircraft are within {{ search_radius_nm | round }} nautical miles of {{ location_label }}.</desc>
        {% endif %}

        <circle class="radar-ring--outer" cx="50" cy="50" r="40" />
        <line class="radar-axis" x1="10" y1="50" x2="90" y2="50" />
        <line class="radar-axis" x1="50" y1="10" x2="50" y2="90" />
        <circle class="radar-ring--inner" cx="50" cy="50" r="20" />

        <path class="radar-tick" d="M50 10v4 M90 50h-4 M50 90v-4 M10 50h4" />
        <path class="radar-center-mark" d="M46.5 50h7 M50 46.5v7" />

        {% if has_aircraft %}
          {% if scope.aircraft_rotation_deg != nil %}
            <path
              class="radar-target"
              d="M224 116c-12 17-17 45-18 77l-72 43v22l72-23 3 57-30 22v17l45-13 45 13v-17l-30-22 3-57 72 23v-22l-72-43c-1-32-6-60-18-77Z"
              transform="translate({{ scope.aircraft_x }} {{ scope.aircraft_y }}) rotate({{ scope.aircraft_rotation_deg }}) scale(.04) translate(-224 -223.5)"
            />
          {% else %}
            <circle class="radar-target-dot" cx="{{ scope.aircraft_x }}" cy="{{ scope.aircraft_y }}" r="2.7" />
          {% endif %}
        {% endif %}

        <g transform="translate({{ scope.north_x }} {{ scope.north_y }})">
          <circle class="radar-north-disc" cx="0" cy="0" r="2.5" />
          <text class="radar-north-label" x="0" y=".2">N</text>
        </g>
        </svg>
      </div>
      <div class="flex flex--row flex--center-y gap--small w--full">
        <span class="label lg:label--large stretch" data-clamp="1">{{ location_label }}</span>
        <span class="label lg:label--large no-shrink">Range {{ scope.range_nm }} NM</span>
      </div>
    </div>
    <div class="divider--v portrait:hidden"></div>
    <div class="divider hidden portrait:block"></div>

    {% if has_aircraft %}
      <div class="flex flex--col flex--left stretch gap--small lg:gap--large">
        <div class="flex flex--col flex--left gap--none w--full">
          <span class="label lg:label--large">Closest contact</span>
          <span class="value value--large lg:value--xlarge" data-value-fit="true">{{ aircraft.identifier }}</span>
          <span class="title lg:title--large w--full" data-clamp="1">{{ aircraft.operator | default: "Airline unavailable" }}</span>
          <span class="description lg:description--large w--full" data-clamp="1">{{ aircraft.route }}</span>
          <span class="label lg:label--large w--full" data-clamp="2">{{ aircraft.registration | default: "Registration unavailable" }} · {{ aircraft.aircraft_name | default: aircraft.aircraft_type | default: "Aircraft unavailable" }}</span>
        </div>
        <div class="divider"></div>
        <div class="grid grid--cols-2 portrait:grid--cols-3 stretch gap--small lg:gap--large">
          <div class="flex flex--col flex--left flex--center-y gap--none">
            <span class="value value--tnums lg:value--large" data-value-fit="true">{{ aircraft.distance_display }}</span>
            <span class="label lg:label--large">Distance</span>
          </div>
          <div class="flex flex--col flex--left flex--center-y gap--none">
            <span class="value value--tnums lg:value--large" data-value-fit="true">{{ aircraft.bearing_compass }} {{ aircraft.bearing_deg }}°</span>
            <span class="label lg:label--large">Bearing true</span>
          </div>
          <div class="flex flex--col flex--left flex--center-y gap--none">
            <span class="value value--tnums lg:value--large" data-value-fit="true">{{ aircraft.altitude_compact }}</span>
            <span class="label lg:label--large">Altitude</span>
          </div>
          <div class="flex flex--col flex--left flex--center-y gap--none">
            <span class="value value--tnums lg:value--large" data-value-fit="true">{{ aircraft.speed_display }}</span>
            <span class="label lg:label--large">Ground speed</span>
          </div>
          <div class="flex flex--col flex--left flex--center-y gap--none">
            <span class="value lg:value--large">{{ aircraft.vertical_trend_short }}</span>
            <span class="label lg:label--large">Vertical trend</span>
            <span class="description lg:description--large w--full" data-clamp="1">{{ aircraft.vertical_rate_display }}</span>
          </div>
          <div class="flex flex--col flex--left flex--center-y gap--none">
            {% if aircraft.direction_deg != nil %}
              <span class="value value--tnums lg:value--large" data-value-fit="true">{{ aircraft.direction_compass }} {{ aircraft.direction_deg }}°</span>
            {% else %}
              <span class="value lg:value--large">—</span>
            {% endif %}
            <span class="label lg:label--large">{{ aircraft.direction_label }}</span>
          </div>
        </div>
      </div>
    {% else %}
      <div class="flex flex--col flex--left flex--center-y stretch gap lg:gap--large">
        <span class="label lg:label--large">Scope clear</span>
        <span class="title title--large lg:title--xxlarge">No fresh aircraft within {{ search_radius_nm | round }} NM.</span>
        <span class="description lg:description--large">Centered on {{ location_label }}.<br>Map up: {{ scope.map_up_compass }} · {{ scope.map_up_bearing_deg }}° true.</span>
      </div>
    {% endif %}
  </div>

  <div class="title_bar">
    <span class="title">Overhead Flight Tracker</span>
    {% if has_aircraft %}
      <span class="instance">{{ aircraft.source_label }} · {{ aircraft.age_display }} · {{ candidate_count }} fresh</span>
    {% else %}
      <span class="instance">{{ location_label }} · {{ scope.map_up_compass }} up</span>
    {% endif %}
  </div>
{% else %}
  <div class="layout layout--col layout--center gap lg:gap--large">
    {% if status == "configuration_error" %}
      <span class="label lg:label--large">Configuration error</span>
      <span class="title title--large lg:title--xxlarge">Tracker not configured</span>
      <span class="description lg:description--large text--center" data-clamp="3">{{ message }}</span>
      <span class="description lg:description--large">Check the plugin location and map settings.</span>
    {% else %}
      <span class="label lg:label--large">Provider error</span>
      <span class="title title--large lg:title--xxlarge">Aircraft data unavailable</span>
      <span class="description lg:description--large text--center" data-clamp="3">{{ message }}</span>
      <span class="description lg:description--large">The tracker will retry on the next refresh.</span>
    {% endif %}
  </div>
  <div class="title_bar">
    <span class="title">Overhead Flight Tracker</span>
    <span class="instance">{{ status }}</span>
  </div>
{% endif %}
