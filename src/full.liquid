{% if has_aircraft %}
  <div class="layout layout--col gap--small">
    <div class="grid grid--cols-2 grow">
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="label label--large">Closest overhead</span>
          <span class="value value--mega" data-fit-value="true">{{ aircraft.identifier }}</span>
          {% if aircraft.operator %}
            <span class="title title--large" data-clamp="1">{{ aircraft.operator }}</span>
            <span class="description description--large" data-clamp="1">{{ aircraft.route }}</span>
          {% else %}
            <span class="title title--large" data-clamp="1">{{ aircraft.route }}</span>
          {% endif %}
          <span class="description">{{ aircraft.aircraft_label }}</span>
        </div>
      </div>

      <div class="grid grid--cols-2">
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="value value--large value--tnums" data-fit-value="true">{{ aircraft.distance_display }}</span>
            <span class="label">{{ aircraft.bearing_compass }} from {{ location_label }}</span>
          </div>
        </div>
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="value value--large value--tnums" data-fit-value="true">{{ aircraft.altitude_compact }}</span>
            <span class="label">Altitude</span>
          </div>
        </div>
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="value value--large value--tnums" data-fit-value="true">{{ aircraft.speed_display }}</span>
            <span class="label">Ground speed</span>
          </div>
        </div>
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="value value--large" data-fit-value="true">{{ aircraft.vertical_trend_short }}</span>
            <span class="label">{{ aircraft.vertical_rate_display }}</span>
          </div>
        </div>
      </div>
    </div>

    <div class="divider"></div>

    <div class="grid grid--cols-4 h--32 no-shrink">
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--small">{{ aircraft.registration | default: "—" }}</span>
          <span class="label">Registration</span>
        </div>
      </div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--small" data-fit-value="true">{{ aircraft.aircraft_name | default: aircraft.aircraft_type | default: "—" }}</span>
          {% if aircraft.aircraft_name and aircraft.aircraft_type %}
            <span class="label">Aircraft · {{ aircraft.aircraft_type }}</span>
          {% else %}
            <span class="label">Aircraft</span>
          {% endif %}
        </div>
      </div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--medium value--tnums">{{ aircraft.heading_compass }} {{ aircraft.heading_deg | default: "—" }}°</span>
          <span class="label">Heading</span>
        </div>
      </div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--small value--tnums">{{ candidate_count }}</span>
          <span class="label">Fresh candidates</span>
        </div>
      </div>
    </div>
  </div>

  <div class="title_bar">
    <span class="title">Overhead Flight Tracker</span>
    <span class="instance">{{ aircraft.source_label }} · {{ aircraft.age_display }}</span>
  </div>
{% else %}
  <div class="layout layout--col layout--center">
    <span class="value value--xxlarge">No aircraft</span>
    <span class="title title--large">{{ message }}</span>
    <span class="description">{{ location_label }}</span>
  </div>
  <div class="title_bar">
    <span class="title">Overhead Flight Tracker</span>
    <span class="instance">{{ status }}</span>
  </div>
{% endif %}
